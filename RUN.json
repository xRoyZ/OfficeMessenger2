{
  "runcontract": 1,
  "services": [
    {
      "name": "db",
      "kind": "database",
      "engine": "postgres"
    },
    {
      "name": "api",
      "dir": "backend",
      "stack": "python",
      "kind": "server",
      "install": [
        [
          "${python}",
          "-m",
          "pip",
          "install",
          "-q",
          "-r",
          "requirements.txt"
        ]
      ],
      "start": [
        "${python}",
        "-m",
        "uvicorn",
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "${PORT}"
      ],
      "port": 8000,
      "port_env": "PORT",
      "health": {
        "path": "/api/health",
        "expect_status": [
          200
        ]
      },
      "test": [
        [
          "${python}",
          "-m",
          "pytest",
          "-q"
        ]
      ],
      "seed": [
        [
          "${python}",
          "-m",
          "app.seed"
        ]
      ],
      "depends_on": [
        "db"
      ],
      "env": {
        "DATABASE_URL": {
          "dev": "${service:db.url}"
        },
        "CORS_ORIGIN": {
          "dev": "${service:web.origin}"
        },
        "SECRET_KEY": {
          "generate": "hex",
          "bytes": 32
        },
        "UPLOAD_DIR": {
          "dev": "./uploads"
        },
        "MAX_UPLOAD_BYTES": {
          "dev": "5242880"
        },
        "TOKEN_TTL_HOURS": {
          "dev": "720",
          "not_secret": true,
          "why": "Session lifetime in hours; a public default, not a credential."
        }
      }
    },
    {
      "name": "web",
      "dir": "frontend",
      "stack": "web-vite",
      "kind": "server",
      "install": [
        [
          "npm",
          "ci"
        ]
      ],
      "build": [
        [
          "npm",
          "run",
          "build"
        ]
      ],
      "start": [
        "npm",
        "run",
        "dev"
      ],
      "port": 5173,
      "port_env": "PORT",
      "health": {
        "path": "/",
        "expect_status": [
          200
        ]
      },
      "test": [
        [
          "npm",
          "test"
        ]
      ],
      "env": {
        "VITE_API_BASE_URL": {
          "dev": "${service:api.origin}"
        }
      }
    }
  ],
  "demo_accounts": {
    "admin": {
      "login": "anna@demo.local",
      "password": "Demo1234!"
    },
    "user": {
      "login": "clara@demo.local",
      "password": "Demo1234!"
    }
  }
}
